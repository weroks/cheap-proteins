Bootstrap: docker
From: continuumio/miniconda3

%files
    $PWD/environment.yaml environment.yaml


%post
    chmod 1777 /tmp
    apt-get update && apt-get -y install libgl1
    conda update -n base -c defaults conda -y
    conda env create -f environment.yaml

    # Source environment at runtime
    echo ". /opt/conda/etc/profile.d/conda.sh" >> $SINGULARITY_ENVIRONMENT
    echo "conda activate cheap" >> $SINGULARITY_ENVIRONMENT

    pip install --no-deps git+https://github.com/amyxlu/openfold.git
    pip install -e .